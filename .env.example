# ── Game server (Render Web Service) ────────────────────────────────────────
# Cổng Render cấp cho Web Service; local dev cũng dùng cổng này.
PORT=10000

# Origin của frontend được phép kết nối WebSocket.
# Nhiều origin thì ngăn bằng dấu phẩy. Để trống hoặc "*" = cho phép tất cả
# (chỉ dùng khi thử nghiệm). CORS_ORIGIN là tên cũ, vẫn còn dùng được.
CLIENT_ORIGIN=https://tongbi.vercel.app

# Sức chứa một phòng — deployment guide: 30 người/room.
MAX_PLAYERS_PER_ROOM=30

# Phòng không còn ai online quá số phút này sẽ bị dọn khỏi RAM.
ROOM_TTL_MINUTES=120

# ── Web client (build-time, Vercel) ─────────────────────────────────────────
# Tương đương NEXT_PUBLIC_GAME_SERVER_URL trong guide — dự án này dùng Vite
# nên tiền tố là VITE_. Bỏ trống khi game server phục vụ luôn bản build.
# VITE_SERVER_URL=https://tong-bi-server.onrender.com
